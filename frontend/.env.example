# Server-only Express origin. Next.js forwards /api requests to this origin.
API_SERVER_URL=http://127.0.0.1:5000
# Public Firebase web configuration (same project as backend Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Only accepted with a demo- project; leave unset for real Firebase.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
