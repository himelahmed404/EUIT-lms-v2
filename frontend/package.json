{
  "name": "euit-lms-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "check": "npm run build && npm --prefix ../backend run test:browser",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "check:pages": "npm run check:accounts",
    "check:links": "npm run check:accounts",
    "check:components": "EUIT_UI_CHECK=components npm run check:accounts",
    "check:motion": "EUIT_UI_CHECK=motion npm run check:accounts",
    "screenshot": "node ../resources/frontend/tools/capture-screenshot.mjs",
    "check:accounts": "npm --prefix ../backend run test:browser"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.67.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/gsap": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5"
  },
  "description": "European IT LMS frontend with Firebase authentication and account APIs"
}
