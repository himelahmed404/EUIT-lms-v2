            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/batches/{{batchId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"version\": {{version}}, \"name\": \"Updated API Batch\", \"startTime\": \"19:00\", \"endTime\": \"21:00\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
