      ]
    },
    {
      "name": "Upload profile photo (select a local JPEG file)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": ""
          }
        },
        "url": "{{baseUrl}}/api/me/photo/upload",
        "description": "Choose a local JPEG in Body > binary. Max 2 MiB. Uploads and attaches the photo; see cloudinary-profile-photos.md."
      }
    }
  ]
}
