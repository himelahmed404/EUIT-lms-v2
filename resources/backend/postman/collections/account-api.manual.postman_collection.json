            }
          ]
        },
        {
          "name": "Enable target LMS profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/admin/profiles/{{targetProfileId}}/access",
            "header": [
              {
                "key": "Authorization",
