# Prisma Postgres pooled URL for application queries
DATABASE_URL=
# Prisma Postgres direct URL for migrations
DIRECT_URL=
PORT=5000
# Absolute path to a Firebase Admin service-account JSON outside the repository
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase project Web API Key, used for verification email delivery
FIREBASE_WEB_API_KEY=

# Cloudinary Free account: backend-only credentials (provide CLOUDINARY_URL or individual keys)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
