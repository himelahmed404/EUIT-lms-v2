{
  "name": "euit-lms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test:integration": "npm run build && node ../resources/backend/tests/student-signup.integration.mjs",
    "test:middleware": "npm run build && node --test ../resources/backend/tests/firebase-email.middleware.test.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed-demo": "node scripts/seed-demo-course.mjs",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "test:postman": "npm run build && node ../resources/backend/tests/profiles-permissions.postman.mjs",
    "test:access": "npm run build && node --test ../resources/backend/tests/firebase-email.middleware.test.mjs ../resources/backend/tests/permissions.authorization.test.mjs ../resources/backend/tests/learning-mvp.test.mjs",
    "test:browser": "npm run build && EUIT_BROWSER_TEST=1 node ../resources/backend/tests/profiles-permissions.postman.mjs",
    "catalog:import-rooms": "node scripts/import-rooms.mjs",
    "test:catalog": "npm run test:postman"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "firebase-admin": "^14.5.1",
    "pg": "^8.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
